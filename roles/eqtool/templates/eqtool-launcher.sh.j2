#!/usr/bin/env bash
# MANAGED BY ANSIBLE - edit roles/eqtool/templates/eqtool-launcher.sh.j2
#
# Launches EqTool against a plain Wine prefix running real .NET Framework 4.8.
# No Steam, no Proton. Every setting below was arrived at by measurement; the
# reasoning is recorded so none of it has to be rediscovered.

set -euo pipefail

EQTOOL_DIR="${EQTOOL_DIR:-{{ eqtool_install_dir }}}"
export WINEPREFIX="${WINEPREFIX:-{{ eqtool_wineprefix }}}"

# wintab32 and winebus enumerate XInput devices and then ask them for button
# mappings. Under XWayland those X device ids are recreated whenever the Wayland
# seat changes, so an id can go stale in between; the resulting XI_BadDevice is
# an unhandled X protocol error, which Xlib turns into an immediate exit - no
# managed stack, no warning, nothing in any log.
#
# The Wayland driver is immune, having no X connection at all, but Wine's
# Wayland driver has no system tray support: the icon becomes a detached window
# that ignores clicks, and the tray menu is the only way into this application.
# Hence X11 with these two disabled. EqTool uses neither tablets nor gamepads.
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-{{ eqtool_dll_overrides }}}"

# fixme-all drops the noisiest channel while keeping err: and warn:. Not -all -
# the crash that revealed 32-bit address space exhaustion and the font FailFast
# that killed startup were both err: lines.
export WINEDEBUG="${WINEDEBUG:-{{ eqtool_winedebug }}}"

if [ ! -d "$WINEPREFIX" ]; then
    echo "Wine prefix not found: $WINEPREFIX" >&2
    echo "Run the Ansible play to build it." >&2
    exit 1
fi

if [ ! -f "$EQTOOL_DIR/EQTool.exe" ]; then
    echo "EQTool.exe not found in $EQTOOL_DIR" >&2
    echo "The build is not managed by Ansible - extract a CI artifact there." >&2
    exit 1
fi

# Keep Wine's output. The application writes no local crash log of its own -
# unhandled exceptions are only POSTed to pigparse, and Errors.txt comes from the
# auto-updater, which is disabled - so this file is the only record of why a
# crash happened. Wine reports a .NET crash as a block of err:eventlog lines
# carrying the exception and its full managed stack.
#
# Launched from the desktop entry there is no terminal to scroll past, and while
# GNOME does route stderr to the systemd user journal, a file per launch is far
# easier to find afterwards.
LOG_DIR="${EQTOOL_LOG_DIR:-{{ eqtool_log_dir }}}"
LOG_KEEP="${EQTOOL_LOG_KEEP:-{{ eqtool_log_keep }}}"
mkdir -p "$LOG_DIR"

# Prune before adding this run's file, so LOG_KEEP is the count afterwards.
# A non-numeric override would make the comparison below fail the script under
# set -e, so treat anything that is not a number as "keep everything".
case "$LOG_KEEP" in
    '' | *[!0-9]*) LOG_KEEP=0 ;;
esac

# Globbed rather than piped from ls: with pipefail an unexpanded glob makes ls
# exit non-zero and takes the whole script with it, which is exactly what
# happens on the very first launch. The filenames sort lexically by date, so
# plain glob order is oldest first.
shopt -s nullglob
existing_logs=("$LOG_DIR"/eqtool-*.log)
shopt -u nullglob

if [ "$LOG_KEEP" -gt 0 ] && [ "${#existing_logs[@]}" -ge "$LOG_KEEP" ]; then
    rm -f -- "${existing_logs[@]:0:$(( ${#existing_logs[@]} - LOG_KEEP + 1 ))}"
fi

# The pid keeps two launches in the same second from sharing a file, which would
# both conflate their output and quietly erode the number kept. The date leads,
# so lexical order stays chronological.
LOG="$LOG_DIR/eqtool-$(date +%Y%m%d-%H%M%S)-$$.log"
echo "Logging to $LOG" >&2

# Redirect this shell through tee, then exec: wine inherits the descriptors, so
# output still reaches a terminal (or the journal) as well as the file, and
# signals go straight to wine rather than through a pipeline.
exec > >(tee -a "$LOG") 2>&1

exec wine "$EQTOOL_DIR/EQTool.exe" "$@"

# What the prefix carries, and why:
#
#   dotnet48    wine-mono's WPF leaks around 50 MB/min - 10 GB in under an hour
#               with no managed object growth at all, since the allocation is
#               native. Real .NET 4.8 measures flat.
#   corefonts   real WPF calls FailFast out of
#               TypefaceMap.MapUnresolvedCharacters when it cannot resolve any
#               font, killing the process during startup.
#   DisableHWAcceleration
#               WPF's hardware path uses Direct3D9, which fails pixel format
#               negotiation under Wine and renders every window black.
#   Graphics={{ eqtool_graphics_driver }}
#               see the note on the tray above.
