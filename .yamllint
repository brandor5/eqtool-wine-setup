---
# Mirrors ansible-lint's built-in yamllint config so that standalone yamllint
# and ansible-lint agree. ansible-lint reads this file too, and rejects it if
# the comments, comments-indentation, braces or octal-values settings drift
# from these values.
extends: default

rules:
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  document-start: disable
  line-length:
    max: 160
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
